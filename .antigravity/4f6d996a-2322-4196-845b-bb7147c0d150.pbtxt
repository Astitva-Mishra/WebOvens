acity: 0 }}\n          animate={{ opacity: 1 }}\n          transition={{ duration: 0.8, delay: 0.5 }}\n        >\n          We are WebOvens, a premium digital agency that crafts bespoke software. \n          We blend passion with elegant code to forge unique, memorable, and high-impact web experiences.\n        </motion.p>\n\n        <motion.div\n           initial={{ opacity: 0, y: 20 }}\n           animate={{ opacity: 1, y: 0 }}\n           transition={{ duration: 0.8, delay: 0.7 }}\n           className=\"flex flex-col sm:flex-row gap-6\"\n        >\n          <Link href=\"#contact\" className=\"px-8 py-4 rounded-full bg-wo-orange text-wo-navy font-bold text-sm tracking-widest uppercase hover:bg-wo-light-orange transition-colors shadow-[0_0_30px_rgba(255,138,0,0.4)]\">\n            Hire the chefs\n          </Link>\n          <Link href=\"#portfolio\" className=\"px-8 py-4 rounded-full border border-wo-white/20 text-wo-white font-bold text-sm tracking-widest uppercase hover:bg-wo-white/5 transition-colors\">\n            View the Menu\n          </Link>\n        </motion.div>\n      </div>\n      \n      {/* Scroll Indicator */}\n      <motion.div \n        className=\"absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-50\"\n        initial={{ opacity: 0 }}\n        animate={{ opacity: 0.5 }}\n        transition={{ delay: 1.5, duration: 1 }}\n      >\n        <span className=\"text-[10px] uppercase tracking-[0.2em]\">Scroll</span>\n        <div className=\"w-[1px] h-12 bg-gradient-to-b from-wo-white to-transparent\" />\n      </motion.div>\n    </section>\n  );\n}"
