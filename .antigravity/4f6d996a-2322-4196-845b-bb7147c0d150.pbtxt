    replacement_chunks {
      replacement_content: "\'use client\';\n\nimport { motion } from \'motion/react\';\nimport { ArrowRight, Mail, MapPin, Phone } from \'lucide-react\';\n\nexport default function Contact() {\n  return (\n    <section id=\"contact\" className=\"py-32 px-6 md:px-12 bg-[#050505] relative overflow-hidden\">\n      {/* Background flare */}\n      <div className=\"absolute bottom-0 right-0 w-[600px] h-[600px] bg-wo-orange/10 rounded-full blur-[100px] pointer-events-none translate-x-1/2 translate-y-1/2\" />\n      \n      <div className=\"max-w-7xl mx-auto\">\n        <div className=\"grid lg:grid-cols-2 gap-20\">\n          <div>\n            <motion.h2 \n              className=\"font-serif text-5xl md:text-7xl text-wo-white mb-6 leading-tight\"\n              initial={{ opacity: 0, y: 20 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true }}\n            >\n              Ready to <br/>\n              <span className=\"text-wo-orange italic\">Serve Success?</span>\n            </motion.h2>\n            <p className=\"text-wo-white/60 text-lg font-light mb-12 max-w-md leading-relaxed\">\n              Let\'s craft something extraordinary together. Reach out to start a conversation about your next digital project.\n            </p>\n\n            <div className=\"space-y-8\">\n              <div className=\"flex items-center gap-4 text-wo-white/80\">\n                <div className=\"w-12 h-12 rounded-full border border-wo-white/10 flex items-center justify-center text-wo-orange\">\n                  <Mail size={20} />\n                </div>\n                <div>\n                  <div className=\"text-xs font-bold uppercase tracking-widest text-wo-white/40 mb-1\">Email Us</div>\n                  <div className=\"font-mono text-sm\">hello@webovens.com</div>\n                </div>\n              </div>\n              \n              <div className=\"flex items-center gap-4 text-wo-white/80\">\n                <div className=\"w-12 h-12 rounded-full border border-wo-white/10 flex items-center justify-center text-wo-orange\">\n                  <MapPin size={20} />\n                </div>\n                <div>\n                  <div className=\"text-xs font-bold uppercase tracking-widest text-wo-white/40 mb-1\">Visit Us</div>\n                  <div className=\"font-mono text-sm\">124 Innovation Dr, Silicon Oven, CA</div>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <motion.div \n            className=\"bg-wo-slate/20 p-8 md:p-12 rounded-[32px] border border-wo-white/10 backdrop-blur-sm\"\n            initial={{ opacity: 0, scale: 0.95 }}\n            whileInView={{ opacity: 1, scale: 1 }}\n            viewport={{ once: true }}\n          >\n            <form className=\"flex flex-col gap-6\" onSubmit={(e) => e.preventDefault()}>\n              <div className=\"grid sm:grid-cols-2 gap-6\">\n                <div>\n                  <label className=\"text-xs font-bold uppercase tracking-widest text-wo-white/60 mb-2 block\">Your Name</label>\n                  <input \n                    type=\"text\" \n                    placeholder=\"John Doe\" \n                    className=\"w-full bg-wo-navy/50 border border-wo-white/10 rounded-xl px-4 py-3 text-wo-white focus:outline-none focus:border-wo-orange/50 transition-colors\"\n                  />\n                </div>\n                <div>\n                  <label className=\"text-xs font-bold uppercase tracking-widest text-wo-white/60 mb-2 block\">Your Email</label>\n                  <input \n                    type=\"email\" \n                    placeholder=\"john@example.com\" \n                    className=\"w-full bg-wo-navy/50 border border-wo-white/10 rounded-xl px-4 py-3 text-wo-white focus:outline-none focus:border-wo-orange/50 transition-colors\"\n                  />\n                </div>\n              </div>\n              \n              <div>\n                <label className=\"text-xs font-bold uppercase tracking-widest text-wo-white/60 mb-2 block\">Project Type</label>\n                <select className=\"w-full bg-wo-navy/50 border border-wo-white/10 rounded-xl px-4 py-3 text-wo-white focus:outline-none focus:border-wo-orange/50 transition-colors appearance-none\">\n                  <option value=\"web\">Web Application</option>\n                  <option value=\"design\">UI/UX Design</option>\n                  <option value=\"mobile\">Mobile App</option>\n                  <option value=\"other\">Other</option>\n                </select>\n              </div>\n\n              <div>\n                <label className=\"text-xs font-bold uppercase tracking-widest text-wo-white/60 mb-2 block\">Tell us about your project</label>\n                <textarea \n                  rows={4}\n                  placeholder=\"What are you looking to build?\" \n                  className=\"w-full bg-wo-navy/50 border border-wo-white/10 rounded-xl px-4 py-3 text-wo-white focus:outline-none focus:border-wo-orange/50 transition-colors resize-none\"\n                />\n              </div>\n\n              <button className=\"flex items-center justify-center gap-2 w-full py-4 rounded-xl bg-wo-orange text-wo-navy font-bold text-sm tracking-widest uppercase hover:bg-wo-light-orange transition-colors mt-2\">\n                Send Request <ArrowRight size={18} />\n              </button>\n            </form>\n          </motion.div>\n        </div>\n      </div>\n    </section>\n  );\n}"
    }
