    replacement_chunks {
      target_content: "\'use client\';\n\nimport { motion } from \'motion/react\';\nimport { Globe, Plus } from \'lucide-react\';\n\nexport default function Contact() {\n  return (\n    <section id=\"about\" className=\"bg-wo-bg py-32 border-b border-wo-border px-6 md:px-16 relative overflow-hidden\">\n      <div className=\"max-w-[1600px] mx-auto flex flex-col lg:flex-row justify-between items-center gap-24 lg:gap-16\">\n        \n        {/* Left Stats/Info */}\n        <div className=\"flex flex-col flex-shrink-0 w-full lg:w-[300px]\">\n          <span className=\"text-[9px] font-bold tracking-[0.25em] uppercase text-wo-text opacity-40 mb-8 block\">BASED IN INDIA</span>\n          <p className=\"text-[13px] text-wo-text-muted leading-relaxed font-light mb-8 max-w-[200px]\">\n            Working with founders and teams around the globe to build exceptional digital experiences.\n          </p>\n          <div className=\"text-wo-text opacity-20\">\n            <Globe strokeWidth={1} size={40} />\n          </div>\n        </div>\n\n        {/* Center Slogan */}\n        <div className=\"flex-grow text-center max-w-4xl\">\n          <motion.h2 \n            className=\"font-serif text-4xl md:text-6xl lg:text-[72px] text-wo-text leading-[1.05] tracking-tight\"\n            initial={{ opacity: 0, y: 20 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: true }}\n          >\n            We don\'t just build products.<br/>\n            We craft digital experiences<br/>\n            that fuel growth and leave<br/>\n            a lasting impact.\n          </motion.h2>\n        </div>\n\n        {/* Right Circular Badge SVG */}\n        <div className=\"flex-shrink-0 w-full lg:w-[300px] flex justify-center lg:justify-end lg:pr-12\">\n           <div className=\"relative w-40 h-40 flex items-center justify-center text-wo-text\">\n             <svg viewBox=\"0 0 100 100\" className=\"w-full h-full animate-[spin_12s_linear_infinite] opacity-60\">\n                 <path id=\"circlePath\" d=\"M 50, 50 m -35, 0 a 35,35 0 1,1 70,0 a 35,35 0 1,1 -70,0\" fill=\"none\" />\n                 <text className=\"text-[10px] font-medium tracking-[0.25em] uppercase\" fill=\"currentColor\">\n                   <textPath href=\"#circlePath\" startOffset=\"0%\">\n                     FORGED WITH PRECISION \342\200\242 \n                   </textPath>\n                 </text>\n             </svg>\n             <div className=\"absolute inset-0 flex items-center justify-center\">\n                <div className=\"w-1.5 h-1.5 bg-wo-orange\" />\n             </div>\n           </div>\n        </div>\n\n      </div>\n    </section>\n  );\n}"
      replacement_content: "\'use client\';\n\nimport { motion } from \'motion/react\';\nimport { Globe, Flame } from \'lucide-react\';\n\nexport default function Contact() {\n  return (\n    <section id=\"about\" className=\"bg-wo-bg py-24 md:py-32 border-b border-wo-border px-6 md:px-12 relative overflow-hidden\">\n      <div className=\"max-w-[1500px] mx-auto flex flex-col lg:flex-row justify-between items-center gap-16 lg:gap-8\">\n        \n        {/* Left Stats/Info */}\n        <div className=\"flex flex-col items-start w-full lg:w-1/4 pt-8\">\n          <span className=\"text-[10px] font-bold tracking-[0.2em] uppercase text-wo-orange mb-6 block\">BASED IN INDIA</span>\n          <p className=\"text-[13px] text-wo-text-muted leading-relaxed font-medium mb-6 max-w-[180px]\">\n             Working with founders and teams around the globe.\n          </p>\n          <div className=\"text-wo-orange/60\">\n            <Globe strokeWidth={1} size={32} />\n          </div>\n        </div>\n\n        {/* Center Slogan */}\n        <div className=\"flex-grow text-center flex items-center justify-center w-full lg:w-1/2 py-10 lg:py-20\">\n          <motion.h2 \n            className=\"font-serif text-3xl md:text-5xl lg:text-[56px] text-wo-text leading-[1.1] tracking-tight\"\n            initial={{ opacity: 0, y: 20 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: true }}\n          >\n            We don\'t just build products.<br/>\n            We craft digital experiences<br/>\n            that fuel <span className=\"text-wo-orange\">growth</span> and leave<br/>\n            a lasting <span className=\"text-wo-orange\">impact.</span>\n          </motion.h2>\n        </div>\n\n        {/* Right Circular Badge SVG */}\n        <div className=\"w-full lg:w-1/4 flex justify-center lg:justify-end items-center lg:pr-8\">\n           <div className=\"relative w-32 h-32 md:w-40 md:h-40 flex items-center justify-center text-wo-text\">\n             <svg viewBox=\"0 0 100 100\" className=\"w-full h-full animate-[spin_12s_linear_infinite]\">\n                 <path id=\"circlePath\" d=\"M 50, 50 m -35, 0 a 35,35 0 1,1 70,0 a 35,35 0 1,1 -70,0\" fill=\"none\" />\n                 <text className=\"text-[10.5px] font-bold tracking-[0.2em] uppercase\" fill=\"currentColor\">\n                   <textPath href=\"#circlePath\" startOffset=\"0%\">\n                     WE COOK APPS. YOU SERVE SUCCESS. \342\200\242 \n                   </textPath>\n                 </text>\n             </svg>\n             <div className=\"absolute inset-0 flex items-center justify-center\">\n                <Flame size={32} strokeWidth={1.5} className=\"text-wo-orange\" />\n             </div>\n           </div>\n        </div>\n\n      </div>\n    </section>\n  );\n}"
