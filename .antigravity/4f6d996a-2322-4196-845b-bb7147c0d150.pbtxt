    replacement_chunks {
      replacement_content: "\'use client\';\n\nimport { motion } from \'motion/react\';\nimport Link from \'next/link\';\nimport { Menu, X } from \'lucide-react\';\nimport { useState } from \'react\';\n\nexport default function Navbar() {\n  const [isOpen, setIsOpen] = useState(false);\n\n  const navLinks = [\n    { name: \'Services\', href: \'#services\' },\n    { name: \'Portfolio\', href: \'#portfolio\' },\n    { name: \'Insights\', href: \'#blog\' },\n  ];\n\n  return (\n    <header className=\"fixed top-0 left-0 right-0 z-50 py-4 px-6 md:px-12 flex justify-between items-center transition-all duration-300 bg-wo-navy/80 backdrop-blur-md border-b border-wo-slate/50\">\n      <Link href=\"/\" className=\"flex items-center gap-2 group\">\n        <div className=\"relative w-10 h-10 flex items-center justify-center rounded-t-full bg-wo-slate border-b-4 border-wo-navy shadow-[0_0_15px_rgba(255,138,0,0.2)] group-hover:shadow-[0_0_20px_rgba(255,138,0,0.4)] transition-all\">\n           {/* Abstract Logo Representation */}\n           <motion.div \n             animate={{ scale: [1, 1.05, 1] }} \n             transition={{ duration: 2, repeat: Infinity, ease: \"easeInOut\" }}\n             className=\"w-5 h-6 bg-gradient-to-t from-[#FFD6A6] via-[#FF8A00] to-transparent rounded-full blur-[1px]\"\n           />\n        </div>\n        <div className=\"flex flex-col\">\n          <span className=\"font-serif text-xl tracking-wide font-bold text-wo-white\">WebOvens</span>\n        </div>\n      </Link>\n\n      <nav className=\"hidden md:flex items-center gap-8\">\n        {navLinks.map((link) => (\n          <Link key={link.name} href={link.href} className=\"text-sm font-medium tracking-wider uppercase text-wo-white/80 hover:text-wo-orange transition-colors\">\n            {link.name}\n          </Link>\n        ))}\n        <Link href=\"#contact\" className=\"px-6 py-2 rounded-full bg-wo-orange text-wo-navy font-bold text-sm tracking-widest uppercase hover:bg-wo-light-orange transition-colors shadow-[0_0_20px_rgba(255,138,0,0.3)] hover:shadow-[0_0_30px_rgba(255,138,0,0.5)]\">\n          Start Cooking\n        </Link>\n      </nav>\n\n      <button className=\"md:hidden text-wo-white\" onClick={() => setIsOpen(!isOpen)}>\n        {isOpen ? <X size={28} /> : <Menu size={28} />}\n      </button>\n\n      {/* Mobile Menu */}\n      {isOpen && (\n        <motion.div\n          initial={{ opacity: 0, y: -20 }}\n          animate={{ opacity: 1, y: 0 }}\n          className=\"absolute top-full left-0 right-0 bg-wo-navy border-b border-wo-slate p-6 flex flex-col gap-6 md:hidden\"\n        >\n          {navLinks.map((link) => (\n            <Link \n              key={link.name} \n              href={link.href} \n              onClick={() => setIsOpen(false)}\n              className=\"text-lg font-medium tracking-wider uppercase text-wo-white\"\n            >\n              {link.name}\n            </Link>\n          ))}\n          <Link \n            href=\"#contact\" \n            onClick={() => setIsOpen(false)}\n            className=\"text-center px-6 py-3 rounded-full bg-wo-orange text-wo-navy font-bold text-sm tracking-widest uppercase\"\n          >\n            Start Cooking\n          </Link>\n        </motion.div>\n      )}\n    </header>\n  );\n}"
    }
