    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "\'use client\';\n\nimport { motion } from \'motion/react\';\nimport { Shield, Diamond, Rocket, Star, Code, Smartphone, Globe } from \'lucide-react\';\n\nexport default function Services() {\n  const services = [\n    {\n      icon: <Globe size={32} strokeWidth={1.5} />,\n      title: \'Web Platforms\',\n      desc: \'High-performance, scalable web apps built with modern stacks (React, Next.js, Node.js). We don\\\'t just build websites; we engineer digital presence.\',\n    },\n    {\n      icon: <Smartphone size={32} strokeWidth={1.5} />,\n      title: \'UI/UX Design\',\n      desc: \'Memorable, intuitive interfaces that convert. We blend aesthetics with user psychology to create designs that feel natural and look stunning.\',\n    },\n    {\n      icon: <Code size={32} strokeWidth={1.5} />,\n      title: \'Custom Software\',\n      desc: \'Complex problems require bespoke solutions. From internal tools to SaaS platforms, we architect software that drives your business forward.\',\n    }\n  ];\n\n  const values = [\n    { icon: <Shield size={24} />, name: \'Trust\' },\n    { icon: <Diamond size={24} />, name: \'Quality\' },\n    { icon: <Rocket size={24} />, name: \'Growth\' },\n    { icon: <Star size={24} />, name: \'Impact\' },\n  ];\n\n  return (\n    <section id=\"services\" className=\"py-32 px-6 md:px-12 bg-wo-navy relative\">\n      <div className=\"max-w-7xl mx-auto\">\n        <div className=\"flex flex-col md:flex-row justify-between items-start mb-24 gap-12\">\n          <div className=\"max-w-2xl\">\n            <p className=\"text-[10px] uppercase tracking-[0.4em] mb-4 opacity-40 text-wo-white\">01 / SERVICES</p>\n            <h2 className=\"text-5xl md:text-[80px] leading-[0.9] font-black tracking-tighter text-wo-white mb-6\">\n              OUR <span className=\"text-wo-light-orange italic font-light\">PROCESS</span>\n            </h2>\n            <p className=\"text-wo-white/60 text-[16px] max-w-md leading-relaxed\">\n              We combine the passion of a fiery oven with the precision of strict code. Our process ensures that every project we deliver is robust, impactful, and tailored to your unique recipe for success.\n            </p>\n          </div>\n          \n          <div className=\"grid grid-cols-2 gap-8 md:gap-12\">\n            {values.map((val, i) => (\n              <motion.div \n                key={i}\n                initial={{ opacity: 0, y: 20 }}\n                whileInView={{ opacity: 1, y: 0 }}\n                viewport={{ once: true }}\n                transition={{ delay: i * 0.1 }}\n                className=\"flex flex-col items-center gap-3 text-wo-white/80\"\n              >\n                <div className=\"text-wo-orange\">{val.icon}</div>\n                <span className=\"text-sm font-semibold tracking-widest uppercase\">{val.name}</span>\n              </motion.div>\n            ))}\n          </div>\n        </div>\n\n        <div className=\"grid md:grid-cols-3 gap-0 border-t border-wo-white/10\">\n          {services.map((svc, i) => (\n            <motion.div \n              key={i}\n              initial={{ opacity: 0, y: 30 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true }}\n              transition={{ delay: i * 0.2 }}\n              className=\"p-12 border-b md:border-b-0 md:border-r border-wo-white/10 bg-wo-slate/20 hover:bg-wo-slate/50 transition-colors group last:border-r-0\"\n            >\n              <p className=\"text-[11px] opacity-40 mb-8 italic\">0{i + 1} / Specialty</p>\n              <div className=\"text-wo-orange mb-6 group-hover:scale-110 group-hover:text-wo-light-orange transition-all duration-500 origin-left\">\n                {svc.icon}\n              </div>\n              <h3 className=\"text-3xl font-light text-wo-white mb-4 group-hover:text-wo-light-orange transition-colors\">{svc.title}</h3>\n              <p className=\"text-[14px] text-wo-white/60 leading-relaxed font-light\">\n                {svc.desc}\n              </p>\n            </motion.div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n}"
      replacement_content: "\'use client\';\n\nimport { motion } from \'motion/react\';\nimport { Rocket, Code, Box, Sparkles, ArrowRight } from \'lucide-react\';\n\nexport default function Services() {\n  const services = [\n    {\n      icon: <Rocket size={24} strokeWidth={1.5} />,\n      title: \'Product Strategy\',\n      desc: \'Turning ideas into clear roadmaps that create real business value.\',\n    },\n    {\n      icon: <Code size={24} strokeWidth={1.5} />,\n      title: \'Web Development\',\n      desc: \'High-performance websites and web apps built with precision and scalability.\',\n    },\n    {\n      icon: <Box size={24} strokeWidth={1.5} />,\n      title: \'UI/UX Design\',\n      desc: \'Beautiful, intuitive interfaces that engage users and strengthen brands.\',\n    },\n    {\n      icon: <Sparkles size={24} strokeWidth={1.5} />,\n      title: \'Brand Experience\',\n      desc: \'Crafting digital experiences that build trust, connection and long-term impact.\',\n    }\n  ];\n\n  return (\n    <section id=\"services\" className=\"bg-wo-bg border-b border-wo-border\">\n      <div className=\"flex flex-col lg:flex-row w-full max-w-[1600px] mx-auto min-h-[300px]\">\n        {/* Left Label */}\n        <div className=\"lg:w-[200px] p-8 lg:p-12 border-b lg:border-b-0 lg:border-r border-wo-border flex-shrink-0\">\n          <span className=\"text-[10px] font-bold tracking-[0.2em] uppercase text-wo-orange\">WHAT WE DO</span>\n        </div>\n\n        {/* Services Grid */}\n        <div className=\"flex-grow grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4\">\n          {services.map((svc, i) => (\n            <motion.div \n              key={i}\n              initial={{ opacity: 0 }}\n              whileInView={{ opacity: 1 }}\n              viewport={{ once: true }}\n              transition={{ delay: i * 0.1 }}\n              className={`p-10 border-b border-wo-border lg:border-b-0 ${i !== services.length - 1 ? \'lg:border-r\' : \'\'}`}\n            >\n              <div className=\"text-wo-text mb-8\">\n                {svc.icon}\n              </div>\n              <h3 className=\"font-serif text-[20px] font-medium text-wo-text mb-4\">{svc.title}</h3>\n              <p className=\"text-[14px] text-wo-text-muted leading-relaxed\">\n                {svc.desc}\n              </p>\n            </motion.div>\n          ))}\n        </div>\n\n        {/* Right Arrow Button */}\n        <div className=\"hidden xl:flex w-[120px] border-l border-wo-border items-center justify-center flex-shrink-0 bg-wo-bg\">\n          <button className=\"w-12 h-12 rounded-full border border-wo-border flex items-center justify-center text-wo-orange hover:bg-wo-orange hover:text-white transition-colors\">\n            <ArrowRight size={18} />\n          </button>\n        </div>\n      </div>\n    </section>\n  );\n}"
    }
