 className=\"hover:text-wo-orange transition-colors\">Twitter</a>\n            <span className=\"opacity-40\">\342\200\242</span>\n            <a href=\"#\" className=\"hover:text-wo-orange transition-colors\">Dribbble</a>\n            <span className=\"opacity-40\">\342\200\242</span>\n            <a href=\"#\" className=\"hover:text-wo-orange transition-colors\">Instagram</a>\n          </div>\n        </div>\n        \n      </div>\n    </footer>\n  );\n}"
