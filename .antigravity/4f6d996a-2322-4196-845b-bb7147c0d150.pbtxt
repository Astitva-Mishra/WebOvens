    replacement_infos {
      original_chunk {
        target_content: "\'use client\';\n\nimport { motion } from \'motion/react\';\nimport Link from \'next/link\';\nimport Image from \'next/image\';\nimport logo from \'../logo.png\';\n\nexport default function Hero() {\n  return (\n    <section className=\"relative min-h-[100svh] flex flex-col justify-center pt-32 pb-20 border-b border-wo-border bg-wo-bg px-6 md:px-16 overflow-hidden\">\n      \n      <div className=\"max-w-[1600px] mx-auto w-full grid lg:grid-cols-2 gap-16 lg:gap-8 items-center relative z-10\">\n        \n        {/* Left Column */}\n        <div className=\"flex flex-col items-start xl:pl-10 relative z-20\">\n          <motion.div\n             initial={{ opacity: 0, y: 20 }}\n             animate={{ opacity: 1, y: 0 }}\n             transition={{ duration: 0.8 }}\n             className=\"flex items-center gap-4 mb-16\"\n          >\n            <div className=\"w-1.5 h-1.5 bg-wo-orange\" />\n            <span className=\"text-[9px] font-bold tracking-[0.25em] uppercase text-wo-text\">DIGITAL CRAFTSMANSHIP</span>\n          </motion.div>\n\n          <motion.h1 \n            className=\"font-serif text-6xl md:text-8xl lg:text-[100px] leading-[0.95] tracking-tighter text-wo-text mb-12\"\n            initial={{ opacity: 0, y: 30 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.8, delay: 0.2 }}\n          >\n            We cook<br />\n            digital products<br />\n            that drive real<br />\n            impact.\n          </motion.h1>\n\n          <motion.p \n            className=\"text-[14px] md:text-[16px] text-wo-text-muted max-w-[420px] leading-relaxed mb-16 font-light\"\n            initial={{ opacity: 0 }}\n            animate={{ opacity: 1 }}\n            transition={{ duration: 0.8, delay: 0.4 }}\n          >\n            We forge high-performance websites, web apps & digital experiences for ambitious brands and visionary founders. No clutter. Just intent.\n          </motion.p>\n\n          <motion.div\n             initial={{ opacity: 0, y: 20 }}\n             animate={{ opacity: 1, y: 0 }}\n             transition={{ duration: 0.8, delay: 0.6 }}\n          >\n            <Link href=\"#portfolio\" className=\"group flex items-center gap-4 py-3 border-b border-wo-border text-wo-text text-[10px] uppercase tracking-[0.2em] font-bold hover:border-wo-text transition-colors\">\n              Read the Manifesto\n              <div className=\"w-1.5 h-1.5 bg-wo-orange transition-transform duration-300 group-hover:scale-150\" />\n            </Link>\n          </motion.div>\n        </div>\n\n        {/* Right Column - Logo Showcase */}\n        <div className=\"relative w-full h-[500px] md:h-[800px] flex items-center justify-center mt-10 lg:mt-0 z-10 pointer-events-none\">\n          <motion.div \n            className=\"absolute right-[-10%] lg:right-[-5%] w-[500px] h-[500px] md:w-[800px] md:h-[800px] lg:w-[1000px] lg:h-[1000px]\"\n            initial={{ opacity: 0, scale: 0.95 }}\n            animate={{ opacity: 1, scale: 1 }}\n            transition={{ duration: 1.2, delay: 0.3 }}\n          >\n            <Image \n              src={logo} \n              alt=\"WebOvens Flame Logo\" \n              fill \n              className=\"object-contain\"\n              priority\n            />\n          </motion.div>\n        </div>\n      </div>\n\n      {/* Vertical Scroll Indicator */}\n      <motion.div \n        className=\"absolute bottom-16 left-6 md:left-16 flex flex-col items-center gap-12 opacity-60\"\n        initial={{ opacity: 0 }}\n        animate={{ opacity: 1 }}\n        transition={{ delay: 1.5, duration: 1 }}\n      >\n        <span className=\"text-[8px] font-bold uppercase tracking-[0.4em] transform -rotate-90 origin-center translate-y-8 text-wo-text\">SCROLL</span>\n        <div className=\"w-[1px] h-24 bg-wo-border mt-8\" />\n      </motion.div>\n\n    </section>\n  );\n}"
        replacement_content: "\'use client\';\n\nimport { motion } from \'motion/react\';\nimport Link from \'next/link\';\nimport Image from \'next/image\';\nimport logo from \'../logo.png\';\n\nexport default function Hero() {\n  return (\n    <section className=\"relative min-h-[100svh] flex flex-col justify-center pt-32 pb-20 border-b border-wo-border bg-wo-bg px-6 md:px-12 overflow-hidden\">\n      \n      {/* Decorative dots in background */}\n      <div className=\"absolute top-32 right-[30%] w-2 h-2 rounded-full bg-wo-orange\" />\n      <div className=\"absolute bottom-40 right-[15%] w-1.5 h-1.5 rounded-full bg-wo-text/20\" />\n      <div className=\"absolute top-64 right-[10%] w-1 h-1 rounded-full bg-wo-text/40\" />\n\n      <div className=\"max-w-[1400px] mx-auto w-full grid lg:grid-cols-2 gap-12 lg:gap-8 items-center relative z-10\">\n        \n        {/* Left Column */}\n        <div className=\"flex flex-col items-start xl:pl-8 relative z-20\">\n          <motion.div\n             initial={{ opacity: 0, y: 20 }}\n             animate={{ opacity: 1, y: 0 }}\n             transition={{ duration: 0.8 }}\n             className=\"flex items-center gap-4 mb-10\"\n          >\n            <span className=\"text-[10px] font-bold tracking-[0.2em] uppercase text-wo-orange bg-wo-bg pr-4\">PREMIUM DIGITAL PRODUCT STUDIO</span>\n            <div className=\"h-[1px] w-12 bg-wo-orange/50\" />\n          </motion.div>\n\n          <motion.h1 \n            className=\"font-serif text-6xl md:text-[80px] lg:text-[96px] leading-[1] tracking-tight text-wo-text mb-8\"\n            initial={{ opacity: 0, y: 30 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.8, delay: 0.2 }}\n          >\n            We <span className=\"text-wo-orange\">Cook</span><br />\n            Digital Products<br />\n            That Drive Real<br />\n            <span className=\"text-wo-orange\">Impact.</span>\n          </motion.h1>\n\n          <motion.p \n            className=\"text-[15px] md:text-[17px] text-wo-text-muted max-w-[420px] leading-relaxed mb-12\"\n            initial={{ opacity: 0 }}\n            animate={{ opacity: 1 }}\n            transition={{ duration: 0.8, delay: 0.4 }}\n          >\n            We design and build high-performance websites,<br />\n            web apps & digital experiences for ambitious<br />\n            brands and visionary founders.\n          </motion.p>\n\n          <motion.div\n             initial={{ opacity: 0, y: 20 }}\n             animate={{ opacity: 1, y: 0 }}\n             transition={{ duration: 0.8, delay: 0.6 }}\n          >\n            <Link href=\"#portfolio\" className=\"group flex items-center gap-3 text-wo-text text-[13px] font-bold border-b border-wo-text pb-1 hover:text-wo-orange hover:border-wo-orange transition-colors\">\n              View Our Work\n              <div className=\"w-1.5 h-1.5 bg-wo-orange rounded-full group-hover:scale-150 transition-transform\" />\n            </Link>\n          </motion.div>\n        </div>\n\n        {/* Right Column - Logo Showcase */}\n        <div className=\"relative w-full h-[500px] md:h-[700px] flex items-center justify-center mt-10 lg:mt-0 z-10 pointer-events-none\">\n          {/* Faint circles behind logo matching the image */}\n          <div className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[400px] md:w-[650px] md:h-[650px] border border-wo-border rounded-full opacity-60\" />\n          <div className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] h-[300px] md:w-[480px] md:h-[480px] border border-wo-border rounded-full opacity-60\" />\n          \n          <motion.div \n            className=\"relative w-[320px] h-[320px] md:w-[550px] md:h-[550px]\"\n            initial={{ opacity: 0, scale: 0.95 }}\n            animate={{ opacity: 1, scale: 1 }}\n            transition={{ duration: 1.2, delay: 0.3 }}\n          >\n            <Image \n              src={logo} \n              alt=\"WebOvens Flame Logo\" \n              fill \n              className=\"object-contain\"\n              priority\n            />\n          </motion.div>\n        </div>\n      </div>\n\n      {/* Vertical Scroll Indicator */}\n      <motion.div \n        className=\"absolute bottom-20 left-6 md:left-12 flex flex-col items-center gap-10 opacity-70\"\n        initial={{ opacity: 0 }}\n        animate={{ opacity: 1 }}\n        transition={{ delay: 1.5, duration: 1 }}\n      >\n        <span className=\"text-[10px] font-medium uppercase tracking-[0.2em] transform -rotate-90 origin-center translate-y-6 text-wo-text\">SCROLL</span>\n        <div className=\"w-[1px] h-20 bg-wo-border mt-6\" />\n        <div className=\"w-1.5 h-1.5 rounded-full bg-wo-orange\" />\n      </motion.div>\n\n      {/* Decorative Text Bottom Right */}\n      <motion.div \n        className=\"absolute bottom-20 right-6 md:right-12 max-w-[200px] hidden sm:block\"\n        initial={{ opacity: 0 }}\n        animate={{ opacity: 1 }}\n        transition={{ delay: 1, duration: 1 }}\n      >\n         <div className=\"text-wo-text mb-4 text-[16px]\">\342\234\246</div>\n         <p className=\"text-[12px] text-wo-text-muted leading-relaxed font-medium\">\n           We craft experiences that<br/>people remember and brands grow on.\n         </p>\n      </motion.div>\n\n    </section>\n  );\n}"
      }
      num_matches: 1
    }
  }
}
