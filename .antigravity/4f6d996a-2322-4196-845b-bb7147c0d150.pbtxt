    replacement_chunks {
      target_content: "\'use client\';\n\nimport { motion } from \'motion/react\';\nimport Image from \'next/image\';\n\nexport default function Portfolio() {\n  const projects = [\n    {\n      title: \'Aura Fintech\',\n      category: \'Web Platform\',\n      image: \'https://picsum.photos/seed/fintech/800/1000\',\n    },\n    {\n      title: \'Lumina Luxury\',\n      category: \'E-Commerce\',\n      image: \'https://picsum.photos/seed/luxury/800/1000\',\n    },\n    {\n      title: \'Nexus Data\',\n      category: \'Dashboard\',\n      image: \'https://picsum.photos/seed/data/800/600\',\n      wide: true,\n    },\n    {\n      title: \'Oasis Wellness\',\n      category: \'Mobile App\',\n      image: \'https://picsum.photos/seed/wellness/800/1000\',\n    }\n  ];\n\n  return (\n    <section id=\"portfolio\" className=\"py-32 px-6 md:px-12 bg-wo-navy border-t border-t-wo-white/10\">\n      <div className=\"max-w-7xl mx-auto\">\n        <div className=\"mb-20 flex flex-col md:flex-row justify-between items-end gap-8\">\n          <div>\n            <p className=\"text-[10px] uppercase tracking-[0.4em] mb-4 opacity-40 text-wo-white\">02 / FEATURED WORK</p>\n            <h2 className=\"text-5xl md:text-[80px] leading-[0.9] font-black tracking-tighter text-wo-white mb-6\">\n              THE <span className=\"text-wo-orange italic font-light\">ARCHIVE</span>\n            </h2>\n            <p className=\"max-w-md text-[16px] leading-relaxed text-wo-white/60\">\n              Explore our recent culinary digital creations. High quality, meticulously crafted, and ready to serve.\n            </p>\n          </div>\n          <button className=\"px-10 py-4 border border-wo-white/20 text-wo-white text-[12px] font-bold tracking-widest uppercase hover:bg-wo-white hover:text-wo-navy transition-colors whitespace-nowrap\">\n            View All Work\n          </button>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-0 border-t border-wo-white/10\">\n          {projects.map((proj, i) => (\n            <motion.div \n              key={i}\n              initial={{ opacity: 0 }}\n              whileInView={{ opacity: 1 }}\n              viewport={{ once: true }}\n              transition={{ delay: i * 0.1 }}\n              className={`group relative overflow-hidden p-8 border-b md:border-b-0 border-r-0 md:odd:border-r border-wo-white/10 ${proj.wide ? \'md:col-span-2 md:border-r-0 md:border-b border-wo-white/10\' : \'\'} min-h-[500px] flex flex-col justify-end`}\n            >\n              <div className=\"absolute inset-0 z-0\">\n                <Image \n                  src={proj.image}\n                  alt={proj.title}\n                  fill\n                  referrerPolicy=\"no-referrer\"\n                  className=\"object-cover opacity-40 transition-transform duration-1000 group-hover:scale-105 group-hover:opacity-70 grayscale group-hover:grayscale-0\"\n                />\n                <div className=\"absolute inset-0 bg-gradient-to-t from-wo-navy via-wo-navy/50 to-transparent opacity-90\" />\n              </div>\n              \n              <div className=\"relative z-10 transition-transform duration-500 translate-y-4 group-hover:translate-y-0\">\n                <span className=\"text-wo-light-orange text-[11px] font-bold tracking-widest uppercase mb-3 block opacity-80\">{proj.category}</span>\n                <h3 className=\"text-4xl font-light text-wo-white\">{proj.title}</h3>\n              </div>\n            </motion.div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n}"
      replacement_content: "\'use client\';\n\nimport { motion } from \'motion/react\';\nimport Image from \'next/image\';\n\nexport default function Portfolio() {\n  const projects = [\n    {\n      title: \'Aura Fintech\',\n      category: \'Web Platform\',\n      image: \'https://picsum.photos/seed/fintech/1200/800\',\n    },\n    {\n      title: \'Lumina Luxury\',\n      category: \'E-Commerce\',\n      image: \'https://picsum.photos/seed/luxury/1200/800\',\n    },\n    {\n      title: \'Nexus Data\',\n      category: \'Dashboard\',\n      image: \'https://picsum.photos/seed/data/1200/800\',\n    },\n  ];\n\n  return (\n    <section id=\"portfolio\" className=\"bg-wo-bg border-b border-wo-border pb-32\">\n      <div className=\"max-w-[1600px] mx-auto\">\n        <div className=\"flex flex-col lg:flex-row justify-between items-end gap-12 p-12 xl:p-16 border-b border-wo-border\">\n          <div className=\"max-w-2xl\">\n            <span className=\"text-[9px] font-bold tracking-[0.25em] uppercase text-wo-text opacity-40 mb-8 block\">02 / FEATURED WORK</span>\n            <h2 className=\"font-serif text-5xl md:text-7xl tracking-tighter text-wo-text mb-6\">\n              Digital products,<br />crafted with purpose<br />and precision.\n            </h2>\n          </div>\n          <button className=\"group flex items-center gap-4 py-3 border-b border-wo-border text-wo-text text-[10px] uppercase tracking-[0.2em] font-bold hover:border-wo-text transition-colors\">\n            Explore All Projects\n            <div className=\"w-1.5 h-1.5 bg-wo-orange transition-transform duration-300 group-hover:scale-150\" />\n          </button>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-0\">\n          {projects.map((proj, i) => (\n            <motion.div \n              key={i}\n              initial={{ opacity: 0 }}\n              whileInView={{ opacity: 1 }}\n              viewport={{ once: true }}\n              transition={{ delay: i * 0.1 }}\n              className={`group flex flex-col border-b lg:border-b-0 border-wo-border ${i !== projects.length - 1 ? \'lg:border-r\' : \'\'}`}\n            >\n              <div className=\"relative aspect-[4/5] overflow-hidden bg-[#EAEAEA]\">\n                <Image \n                  src={proj.image}\n                  alt={proj.title}\n                  fill\n                  referrerPolicy=\"no-referrer\"\n                  className=\"object-cover opacity-80 mix-blend-multiply transition-transform duration-1000 group-hover:scale-[1.03] grayscale group-hover:grayscale-0\"\n                />\n              </div>\n              <div className=\"p-8 lg:p-12 flex flex-col justify-between flex-grow bg-wo-bg\">\n                <span className=\"text-[10px] uppercase tracking-[0.2em] font-bold opacity-40 mb-4\">{proj.category}</span>\n                <div className=\"flex justify-between items-center mt-auto\">\n                  <h3 className=\"font-serif text-3xl font-light text-wo-text group-hover:italic transition-all\">{proj.title}</h3>\n                  <div className=\"w-8 h-8 rounded-full border border-wo-border flex items-center justify-center opacity-0 -translate-x-4 group-hover:opacity-100 group-hover:translate-x-0 transition-all text-wo-text\">\n                    <span className=\"text-[10px]\">\342\206\222</span>\n                  </div>\n                </div>\n              </div>\n            </motion.div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n}"
    }
