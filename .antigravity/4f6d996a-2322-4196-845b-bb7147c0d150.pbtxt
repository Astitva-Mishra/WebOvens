    replacement_chunks {
      replacement_content: "\'use client\';\n\nimport { motion } from \'motion/react\';\nimport Image from \'next/image\';\n\nexport default function Portfolio() {\n  const projects = [\n    {\n      title: \'Aura Fintech\',\n      category: \'Web Platform\',\n      image: \'https://picsum.photos/seed/fintech/800/1000\',\n    },\n    {\n      title: \'Lumina Luxury\',\n      category: \'E-Commerce\',\n      image: \'https://picsum.photos/seed/luxury/800/1000\',\n    },\n    {\n      title: \'Nexus Data\',\n      category: \'Dashboard\',\n      image: \'https://picsum.photos/seed/data/800/600\',\n      wide: true,\n    },\n    {\n      title: \'Oasis Wellness\',\n      category: \'Mobile App\',\n      image: \'https://picsum.photos/seed/wellness/800/1000\',\n    }\n  ];\n\n  return (\n    <section id=\"portfolio\" className=\"py-32 px-6 md:px-12 bg-[#050505]\">\n      <div className=\"max-w-7xl mx-auto\">\n        <div className=\"mb-20 flex flex-col md:flex-row justify-between items-end gap-8\">\n          <div>\n            <h2 className=\"font-serif text-4xl md:text-6xl text-wo-white mb-4\">\n              Fresh from the <span className=\"text-wo-orange italic\">Oven</span>\n            </h2>\n            <p className=\"text-wo-white/60 text-lg font-light max-w-lg\">\n              Explore our recent culinary digital creations. High quality, meticulously crafted, and ready to serve.\n            </p>\n          </div>\n          <button className=\"px-6 py-2 rounded-full border border-wo-white/20 text-wo-white text-sm font-semibold tracking-wider uppercase hover:bg-wo-white hover:text-black transition-colors whitespace-nowrap\">\n            View All Work\n          </button>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\">\n          {projects.map((proj, i) => (\n            <motion.div \n              key={i}\n              initial={{ opacity: 0, y: 30 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true }}\n              transition={{ delay: i * 0.1 }}\n              className={`group relative overflow-hidden rounded-[24px] ${proj.wide ? \'md:col-span-2 lg:col-span-2\' : \'\'} aspect-[4/5] sm:aspect-auto sm:min-h-[500px]`}\n            >\n              <Image \n                src={proj.image}\n                alt={proj.title}\n                fill\n                referrerPolicy=\"no-referrer\"\n                className=\"object-cover transition-transform duration-700 group-hover:scale-105\"\n              />\n              <div className=\"absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-60 group-hover:opacity-80 transition-opacity\" />\n              \n              <div className=\"absolute bottom-0 left-0 right-0 p-8 translate-y-4 group-hover:translate-y-0 transition-transform duration-500\">\n                <span className=\"text-wo-orange text-xs font-bold tracking-widest uppercase mb-2 block\">{proj.category}</span>\n                <h3 className=\"font-serif text-3xl text-white\">{proj.title}</h3>\n              </div>\n            </motion.div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n}"
    }
