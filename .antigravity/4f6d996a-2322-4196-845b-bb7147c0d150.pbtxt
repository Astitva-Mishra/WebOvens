    instruction: "Redesign Navbar to match the light theme design"
    replacement_infos {
      original_chunk {
        target_content: "\'use client\';\n\nimport { motion } from \'motion/react\';\nimport Link from \'next/link\';\nimport { Menu, X } from \'lucide-react\';\nimport { useState } from \'react\';\n\nexport default function Navbar() {\n  const [isOpen, setIsOpen] = useState(false);\n\n  const navLinks = [\n    { name: \'Services\', href: \'#services\' },\n    { name: \'Portfolio\', href: \'#portfolio\' },\n    { name: \'Insights\', href: \'#blog\' },\n  ];\n\n  return (\n    <header className=\"fixed top-0 left-0 right-0 z-50 py-10 px-6 md:px-12 flex justify-between items-baseline transition-all duration-300 bg-wo-navy/90 backdrop-blur-md border-b border-wo-white/10\">\n      <Link href=\"/\" className=\"flex flex-col group\">\n          <span className=\"font-serif text-[32px] font-bold tracking-tighter leading-none text-wo-white uppercase\">WebOvens.</span>\n          <span className=\"text-[10px] tracking-[0.3em] text-wo-white/60 uppercase mt-1 italic hidden sm:block\">Creative Agency & Digital Lab</span>\n      </Link>\n\n      <nav className=\"hidden md:flex items-center gap-12 text-[11px] font-medium tracking-widest uppercase text-wo-white\">\n        {navLinks.map((link) => (\n          <Link key={link.name} href={link.href} className=\"hover:text-wo-light-orange transition-colors\">\n            {link.name}\n          </Link>\n        ))}\n        <Link href=\"#contact\" className=\"text-wo-orange underline underline-offset-8 hover:text-wo-light-orange transition-colors\">\n          Contact\n        </Link>\n      </nav>\n\n      <button className=\"md:hidden text-wo-white\" onClick={() => setIsOpen(!isOpen)}>\n        {isOpen ? <X size={28} /> : <Menu size={28} />}\n      </button>\n\n      {/* Mobile Menu */}\n      {isOpen && (\n        <motion.div\n          initial={{ opacity: 0, y: -20 }}\n          animate={{ opacity: 1, y: 0 }}\n          className=\"absolute top-full left-0 right-0 bg-wo-navy border-b border-wo-slate p-6 flex flex-col gap-6 md:hidden\"\n        >\n          {navLinks.map((link) => (\n            <Link \n              key={link.name} \n              href={link.href} \n              onClick={() => setIsOpen(false)}\n              className=\"text-lg font-medium tracking-wider uppercase text-wo-white\"\n            >\n              {link.name}\n            </Link>\n          ))}\n          <Link \n            href=\"#contact\" \n            onClick={() => setIsOpen(false)}\n            className=\"text-center px-6 py-3 rounded-full bg-wo-orange text-wo-navy font-bold text-sm tracking-widest uppercase\"\n          >\n            Start Cooking\n          </Link>\n        </motion.div>\n      )}\n    </header>\n  );\n}"
        replacement_content: "\'use client\';\n\nimport { motion } from \'motion/react\';\nimport Link from \'next/link\';\nimport { Menu, X } from \'lucide-react\';\nimport { useState } from \'react\';\nimport Image from \'next/image\';\nimport logo from \'../logo.png\';\n\nexport default function Navbar() {\n  const [isOpen, setIsOpen] = useState(false);\n\n  const navLinks = [\n    { name: \'Work\', href: \'#portfolio\' },\n    { name: \'Services\', href: \'#services\' },\n    { name: \'About\', href: \'#about\' },\n    { name: \'Process\', href: \'#process\' },\n    { name: \'Insights\', href: \'#blog\' },\n  ];\n\n  return (\n    <header className=\"fixed top-0 left-0 right-0 z-50 py-6 px-6 md:px-12 flex justify-between items-center transition-all duration-300 bg-wo-bg/90 backdrop-blur-md\">\n      <Link href=\"/\" className=\"flex items-center gap-3 group\">\n        <div className=\"relative w-8 h-8 rounded-full overflow-hidden flex items-center justify-center\">\n          <Image src={logo} alt=\"WebOvens Logo\" fill className=\"object-cover\" />\n        </div>\n        <span className=\"font-serif text-[28px] font-medium tracking-tight text-wo-text\">WebOvens</span>\n      </Link>\n\n      <nav className=\"hidden lg:flex items-center gap-10 text-[14px] font-medium text-wo-text\">\n        {navLinks.map((link) => (\n          <Link key={link.name} href={link.href} className=\"hover:text-wo-orange transition-colors\">\n            {link.name}\n          </Link>\n        ))}\n      </nav>\n\n      <div className=\"hidden lg:flex items-center\">\n        <Link href=\"#contact\" className=\"flex items-center gap-2 px-6 py-2.5 rounded-full border border-wo-border font-medium text-[14px] text-wo-text hover:border-wo-orange hover:text-wo-orange transition-colors\">\n          Let\'s Talk\n          <div className=\"w-2 h-2 rotate-45 bg-wo-orange\"></div>\n        </Link>\n      </div>\n\n      <button className=\"lg:hidden text-wo-text\" onClick={() => setIsOpen(!isOpen)}>\n        {isOpen ? <X size={28} /> : <Menu size={28} />}\n      </button>\n\n      {/* Mobile Menu */}\n      {isOpen && (\n        <motion.div\n          initial={{ opacity: 0, y: -20 }}\n          animate={{ opacity: 1, y: 0 }}\n          className=\"absolute top-full left-0 right-0 bg-wo-white border-b border-wo-border p-6 flex flex-col gap-6 lg:hidden shadow-lg\"\n        >\n          {navLinks.map((link) => (\n            <Link \n              key={link.name} \n              href={link.href} \n              onClick={() => setIsOpen(false)}\n              className=\"text-lg font-medium text-wo-text hover:text-wo-orange\"\n            >\n              {link.name}\n            </Link>\n          ))}\n          <Link \n            href=\"#contact\" \n            onClick={() => setIsOpen(false)}\n            className=\"flex items-center justify-center gap-2 px-6 py-3 rounded-full border border-wo-border text-wo-text font-medium\"\n          >\n            Let\'s Talk\n            <div className=\"w-2 h-2 rotate-45 bg-wo-orange\"></div>\n          </Link>\n        </motion.div>\n      )}\n    </header>\n  );\n}"
      }
      num_matches: 1
    }
