sName=\"hover:text-wo-white transition-colors\">Terms of Service</a>\n        </div>\n      </div>\n    </footer>\n  );\n}"
      replacement_content: "import Link from \'next/link\';\n\nexport default function Footer() {\n  const brands = [\n    { name: \'LUMEN\', icon: \'\342\227\222\' },\n    { name: \'NEXORA\', icon: \'\342\227\206\' },\n    { name: \'FortuneFlow\', icon: \'F\' },\n    { name: \'PULSE.\', icon: \'\' },\n    { name: \'PARALLAX\', icon: \'\342\234\272\' },\n  ];\n\n  return (\n    <footer className=\"bg-wo-bg px-6 md:px-12 pt-24 pb-12\">\n      <div className=\"max-w-[1440px] mx-auto\">\n        \n        {/* Trusted By Section */}\n        <div className=\"flex flex-col xl:flex-row items-center gap-12 lg:gap-24 mb-32 border-b border-t border-wo-border py-12\">\n          <span className=\"text-[10px] font-bold tracking-[0.2em] uppercase text-wo-orange whitespace-nowrap min-w-[220px]\">\n            TRUSTED BY AMBITIOUS BRANDS\n          </span>\n          <div className=\"flex flex-wrap justify-center xl:justify-between items-center w-full gap-8 md:gap-16 opacity-60 grayscale hover:grayscale-0 transition-all duration-500\">\n             {brands.map((brand, i) => (\n               <div key={i} className=\"flex items-center gap-2 text-wo-text font-medium text-lg tracking-wider\">\n                 {brand.icon && <span className=\"font-sans\">{brand.icon}</span>}\n                 <span>{brand.name}</span>\n               </div>\n             ))}\n          </div>\n        </div>\n\n        {/* Bottom Footer Details */}\n        <div className=\"flex flex-col md:flex-row justify-between items-center gap-8 mt-12 text-[12px] text-wo-text-muted font-medium\">\n          <p>&copy; {new Date().getFullYear()} WebOvens. All rights reserved.</p>\n          \n          <p className=\"hover:text-wo-text transition-colors\">hello@webovens.com</p>\n\n          <div className=\"flex gap-4 sm:gap-8\">\n            <a href=\"#\" className=\"hover:text-wo-orange transition-colors\">LinkedIn</a>\n            <span className=\"opacity-40\">\342\200\242</span>\n            <a href=\"#\" className=\"hover:text-wo-orange transition-colors\">Twitter</a>\n            <span className=\"opacity-40\">\342\200\242</span>\n            <a href=\"#\" className=\"hover:text-wo-orange transition-colors\">Dribbble</a>\n            <span className=\"opacity-40\">\342\200\242</span>\n            <a href=\"#\" className=\"hover:text-wo-orange transition-colors\">Instagram</a>\n          </div>\n        </div>\n        \n      </div>\n    </footer>\n  );\n}"
