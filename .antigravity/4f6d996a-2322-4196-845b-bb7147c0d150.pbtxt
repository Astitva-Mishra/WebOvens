      target_content: "\'use client\';\n\nimport { motion } from \'motion/react\';\nimport { Rocket, Code, Box, Sparkles, Plus } from \'lucide-react\';\n\nexport default function Services() {\n  const services = [\n    {\n      icon: <Rocket size={20} strokeWidth={1} />,\n      title: \'Product Strategy\',\n      desc: \'Turning ideas into clear roadmaps that create real business value.\',\n    },\n    {\n      icon: <Code size={20} strokeWidth={1} />,\n      title: \'Web Development\',\n      desc: \'High-performance websites and web apps built with precision and scalability.\',\n    },\n    {\n      icon: <Box size={20} strokeWidth={1} />,\n      title: \'UI/UX Design\',\n      desc: \'Beautiful, intuitive interfaces that engage users and strengthen brands.\',\n    },\n    {\n      icon: <Sparkles size={20} strokeWidth={1} />,\n      title: \'Brand Experience\',\n      desc: \'Crafting digital experiences that build trust, connection and long-term impact.\',\n    }\n  ];\n\n  return (\n    <section id=\"services\" className=\"bg-wo-bg border-b border-wo-border\">\n      <div className=\"flex flex-col xl:flex-row w-full max-w-[1600px] mx-auto min-h-[400px]\">\n        {/* Left Label */}\n        <div className=\"xl:w-[300px] p-12 xl:p-16 border-b xl:border-b-0 xl:border-r border-wo-border flex-shrink-0 flex xl:items-center\">\n          <span className=\"text-[9px] font-bold tracking-[0.25em] uppercase text-wo-text opacity-40\">WHAT WE DO</span>\n        </div>\n\n        {/* Services Grid */}\n        <div className=\"flex-grow grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4\">\n          {services.map((svc, i) => (\n            <motion.div \n              key={i}\n              initial={{ opacity: 0 }}\n              whileInView={{ opacity: 1 }}\n              viewport={{ once: true }}\n              transition={{ delay: i * 0.1 }}\n              className={`p-12 xl:p-16 border-b border-wo-border lg:border-b-0 group flex flex-col justify-between hover:bg-[#F0F0EA] transition-colors duration-500 ${i !== services.length - 1 ? \'lg:border-r\' : \'\'}`}\n            >\n              <div className=\"text-wo-text opacity-40 group-hover:opacity-100 transition-opacity duration-500 mb-16\">\n                {svc.icon}\n              </div>\n              <div>\n                <h3 className=\"font-serif text-[24px] text-wo-text mb-6\">{svc.title}</h3>\n                <p className=\"text-[13px] text-wo-text-muted leading-relaxed font-light\">\n                  {svc.desc}\n                </p>\n              </div>\n            </motion.div>\n          ))}\n        </div>\n\n        {/* Right Decorator */}\n        <div className=\"hidden 2xl:flex w-[150px] border-l border-wo-border items-end justify-end flex-shrink-0 bg-wo-bg p-8\">\n           <div className=\"w-1.5 h-1.5 bg-wo-orange\" />\n        </div>\n      </div>\n    </section>\n  );\n}"
      replacement_content: "\'use client\';\n\nimport { motion } from \'motion/react\';\nimport { Box, ArrowRight, Rocket } from \'lucide-react\';\n\nexport default function Services() {\n  const services = [\n    {\n      icon: <Rocket size={24} strokeWidth={1} />,\n      title: \'Product Strategy\',\n      desc: \'Turning ideas into clear roadmaps that create real business value.\',\n    },\n    {\n      icon: <span className=\"font-mono text-2xl tracking-tight leading-none\">&lt;/&gt;</span>,\n      title: \'Web Development\',\n      desc: \'High-performance websites and web apps built with precision and scalability.\',\n    },\n    {\n      icon: <Box size={24} strokeWidth={1} />,\n      title: \'UI/UX Design\',\n      desc: \'Beautiful, intuitive interfaces that engage users and strengthen brands.\',\n    },\n    {\n      icon: (\n        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"1\" strokeLinecap=\"square\">\n          <path d=\"M12 2v20 M2 12h20 M4.9 4.9l14.2 14.2 M4.9 19.1l14.2-14.2\" />\n        </svg>\n      ),\n      title: \'Brand Experience\',\n      desc: \'Crafting digital experiences that build trust, connection and long-term impact.\',\n    }\n  ];\n\n  return (\n    <section id=\"services\" className=\"bg-wo-bg border-b border-wo-border\">\n      <div className=\"w-full flex justify-center\">\n        <div className=\"w-full max-w-[1500px] flex flex-col lg:flex-row min-h-[300px]\">\n          \n          {/* Left Label */}\n          <div className=\"w-full lg:w-48 p-8 border-b lg:border-b-0 lg:border-r border-wo-border flex-shrink-0 pt-16\">\n            <span className=\"text-[9px] font-bold tracking-[0.2em] uppercase text-wo-orange\">WHAT WE DO</span>\n          </div>\n\n          {/* Services Grid */}\n          <div className=\"flex-grow grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4\">\n            {services.map((svc, i) => (\n              <motion.div \n                key={i}\n                initial={{ opacity: 0 }}\n                whileInView={{ opacity: 1 }}\n                viewport={{ once: true }}\n                transition={{ delay: i * 0.1 }}\n                className={`p-10 border-b border-wo-border lg:border-b-0 flex flex-col justify-center min-h-[300px] ${i !== services.length - 1 ? \'lg:border-r border-wo-border\' : \'\'}`}\n              >\n                <div className=\"text-wo-text mb-8 w-10 h-10 flex items-center justify-start opacity-80\">\n                  {svc.icon}\n                </div>\n                <h3 className=\"font-serif text-[20px] text-wo-text mb-4\">{svc.title}</h3>\n                <p className=\"text-[13px] text-wo-text-muted leading-relaxed max-w-[200px]\">\n                  {svc.desc}\n                </p>\n              </motion.div>\n            ))}\n          </div>\n\n          {/* Right Arrow Button Container */}\n          <div className=\"hidden lg:flex w-24 border-l border-wo-border items-center justify-center flex-shrink-0 bg-wo-bg\">\n            <button className=\"w-12 h-12 rounded-full border border-wo-border flex items-center justify-center text-wo-orange hover:border-wo-orange transition-colors\">\n              <ArrowRight strokeWidth={1} size={20} />\n            </button>\n          </div>\n\n        </div>\n      </div>\n    </section>\n  );\n}"
    }
