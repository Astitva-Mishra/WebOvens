    instruction: "Change Contact section to the Slogan/Testimonial section from the image"
    replacement_infos {
      original_chunk {
        target_content: "\'use client\';\n\nimport { motion } from \'motion/react\';\nimport { ArrowRight, Mail, MapPin, Phone } from \'lucide-react\';\n\nexport default function Contact() {\n  return (\n    <section id=\"contact\" className=\"py-32 px-6 md:px-12 bg-wo-navy relative overflow-hidden border-t border-t-wo-white/10\">\n      {/* Background flare */}\n      <div className=\"absolute bottom-0 right-0 w-[600px] h-[600px] bg-wo-orange/10 rounded-full blur-[100px] pointer-events-none translate-x-1/2 translate-y-1/2\" />\n      \n      <div className=\"max-w-7xl mx-auto\">\n        <div className=\"grid lg:grid-cols-2 gap-20\">\n          <div>\n            <motion.h2 \n              className=\"text-5xl md:text-[80px] leading-[0.9] font-black tracking-tighter text-wo-white mb-6\"\n              initial={{ opacity: 0, y: 20 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true }}\n            >\n              READY TO <br/>\n              <span className=\"text-wo-orange italic font-light\">BUILD?</span>\n            </motion.h2>\n            <p className=\"text-wo-white/60 text-[16px] mb-12 max-w-sm leading-relaxed\">\n              Let\'s craft something extraordinary together. Reach out to start a conversation about your next digital project.\n            </p>\n\n            <div className=\"space-y-8 pt-8 border-t border-wo-white/10\">\n              <div className=\"flex items-center gap-6 text-wo-white/80\">\n                <div className=\"flex-shrink-0 w-12 h-12 bg-wo-white/5 flex items-center justify-center text-[10px] italic\">01</div>\n                <div>\n                  <div className=\"text-[10px] uppercase tracking-widest text-wo-white/40 mb-1\">Email Us</div>\n                  <div className=\"text-[14px]\">hello@webovens.com</div>\n                </div>\n              </div>\n              \n              <div className=\"flex items-center gap-6 text-wo-white/80\">\n                <div className=\"flex-shrink-0 w-12 h-12 bg-wo-white/5 flex items-center justify-center text-[10px] italic\">02</div>\n                <div>\n                  <div className=\"text-[10px] uppercase tracking-widest text-wo-white/40 mb-1\">Visit Us</div>\n                  <div className=\"text-[14px]\">124 Innovation Dr, Silicon Oven, CA</div>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <motion.div \n            className=\"bg-wo-slate/50 p-8 md:p-12 border border-wo-white/10\"\n            initial={{ opacity: 0, scale: 0.95 }}\n            whileInView={{ opacity: 1, scale: 1 }}\n            viewport={{ once: true }}\n          >\n            <form className=\"flex flex-col gap-6\" onSubmit={(e) => e.preventDefault()}>\n              <div className=\"grid sm:grid-cols-2 gap-6\">\n                <div>\n                  <label className=\"text-[10px] font-bold uppercase tracking-widest text-wo-white/60 mb-2 block\">Your Name</label>\n                  <input \n                    type=\"text\" \n                    placeholder=\"John Doe\" \n                    className=\"w-full bg-wo-navy/50 border border-wo-white/10 px-4 py-3 text-wo-white focus:outline-none focus:border-wo-orange/50 transition-colors\"\n                  />\n                </div>\n                <div>\n                  <label className=\"text-[10px] font-bold uppercase tracking-widest text-wo-white/60 mb-2 block\">Your Email</label>\n                  <input \n                    type=\"email\" \n                    placeholder=\"john@example.com\" \n                    className=\"w-full bg-wo-navy/50 border border-wo-white/10 px-4 py-3 text-wo-white focus:outline-none focus:border-wo-orange/50 transition-colors\"\n                  />\n                </div>\n              </div>\n              \n              <div>\n                <label className=\"text-[10px] font-bold uppercase tracking-widest text-wo-white/60 mb-2 block\">Project Type</label>\n                <select className=\"w-full bg-wo-navy/50 border border-wo-white/10 px-4 py-3 text-wo-white focus:outline-none focus:border-wo-orange/50 transition-colors appearance-none\">\n                  <option value=\"web\">Web Application</option>\n                  <option value=\"design\">UI/UX Design</option>\n                  <option value=\"mobile\">Mobile App</option>\n                  <option value=\"other\">Other</option>\n                </select>\n              </div>\n\n              <div>\n                <label className=\"text-[10px] font-bold uppercase tracking-widest text-wo-white/60 mb-2 block\">Tell us about your project</label>\n                <textarea \n                  rows={4}\n                  placeholder=\"What are you looking to build?\" \n                  className=\"w-full bg-wo-navy/50 border border-wo-white/10 px-4 py-3 text-wo-white focus:outline-none focus:border-wo-orange/50 transition-colors resize-none\"\n                />\n              </div>\n\n              <button className=\"flex items-center justify-center gap-2 w-full py-4 bg-wo-white text-wo-navy font-bold text-[12px] tracking-widest uppercase hover:bg-wo-orange hover:text-wo-white transition-colors mt-2\">\n                Send Request <ArrowRight size={18} />\n              </button>\n            </form>\n          </motion.div>\n        </div>\n      </div>\n    </section>\n  );\n}"
        replacement_content: "\'use client\';\n\nimport { motion } from \'motion/react\';\nimport { Globe, Flame } from \'lucide-react\';\n\nexport default function Contact() {\n  return (\n    <section id=\"about\" className=\"bg-wo-bg py-24 md:py-32 border-b border-wo-border px-6 md:px-12 relative overflow-hidden\">\n      <div className=\"max-w-[1440px] mx-auto flex flex-col lg:flex-row justify-between items-center gap-16 lg:gap-8\">\n        \n        {/* Left Stats/Info */}\n        <div className=\"flex flex-col flex-shrink-0 w-full lg:w-[240px]\">\n          <span className=\"text-[10px] font-bold tracking-[0.2em] uppercase text-wo-orange mb-6 block\">BASED IN INDIA</span>\n          <p className=\"text-[14px] text-wo-text-muted leading-relaxed mb-6\">\n            Working with founders and teams around the globe.\n          </p>\n          <div className=\"text-wo-orange opacity-60\">\n            <Globe strokeWidth={1} size={32} />\n          </div>\n        </div>\n\n        {/* Center Slogan */}\n        <div className=\"flex-grow text-center max-w-3xl\">\n          <motion.h2 \n            className=\"font-serif text-3xl md:text-5xl lg:text-6xl text-wo-text leading-tight\"\n            initial={{ opacity: 0, y: 20 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: true }}\n          >\n            We don\'t just build products.<br/>\n            We craft digital experiences<br/>\n            that fuel <span className=\"text-wo-orange\">growth</span> and leave<br/>\n            a lasting <span className=\"text-wo-orange\">impact.</span>\n          </motion.h2>\n        </div>\n\n        {/* Right Circular Badge SVG */}\n        <div className=\"flex-shrink-0 w-full lg:w-[240px] flex justify-center lg:justify-end\">\n           <div className=\"relative w-40 h-40 flex items-center justify-center text-wo-orange\">\n             <svg viewBox=\"0 0 100 100\" className=\"w-full h-full animate-[spin_10s_linear_infinite]\">\n                 <path id=\"circlePath\" d=\"M 50, 50 m -35, 0 a 35,35 0 1,1 70,0 a 35,35 0 1,1 -70,0\" fill=\"none\" />\n                 <text className=\"text-[11px] font-bold uppercase tracking-[0.2em]\" fill=\"currentColor\">\n                   <textPath href=\"#circlePath\" startOffset=\"0%\">\n                     WE COOK APPS. YOU SERVE SUCCESS. \342\200\242 \n                   </textPath>\n                 </text>\n             </svg>\n             <div className=\"absolute inset-0 flex items-center justify-center\">\n                <Flame size={32} strokeWidth={1.5} className=\"text-wo-orange\" />\n             </div>\n           </div>\n        </div>\n\n      </div>\n    </section>\n  );\n}"
      }
      num_matches: 1
    }
  }
}
