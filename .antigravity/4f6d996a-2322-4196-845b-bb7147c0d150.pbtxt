\n                <span className=\"text-wo-white/40 text-sm font-mono\">{post.date}</span>\n                <span className=\"w-1 h-1 rounded-full bg-wo-orange\" />\n                <span className=\"text-wo-orange text-xs font-bold uppercase tracking-widest\">{post.category}</span>\n              </div>\n              <div className=\"flex justify-between items-center pr-4\">\n                <h3 className=\"font-serif text-2xl md:text-3xl text-wo-white group-hover:text-wo-light-orange transition-colors\">\n                  {post.title}\n                </h3>\n                <div className=\"w-10 h-10 rounded-full border border-wo-white/10 flex items-center justify-center opacity-0 -translate-x-4 group-hover:opacity-100 group-hover:translate-x-0 transition-all text-wo-orange group-hover:border-wo-orange/30\">\n                  <ArrowRight size={18} />\n                </div>\n              </div>\n            </motion.div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n}"
