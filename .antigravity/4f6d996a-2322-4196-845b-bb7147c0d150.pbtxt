cts.map((proj, i) => (\n              <motion.div \n                key={i}\n                initial={{ opacity: 0, y: 20 }}\n                whileInView={{ opacity: 1, y: 0 }}\n                viewport={{ once: true }}\n                transition={{ delay: i * 0.1 }}\n                className=\"group relative overflow-hidden bg-gray-100 aspect-square rounded-sm\"\n              >\n                <Image \n                  src={proj.image}\n                  alt={proj.title}\n                  fill\n                  referrerPolicy=\"no-referrer\"\n                  className=\"object-cover transition-transform duration-700 group-hover:scale-105\"\n                />\n                {/* Gradient overlay for text readability */}\n                <div className={`absolute inset-0 bg-gradient-to-t ${proj.dark ? \'from-black/80\' : \'from-black/40\'} via-transparent to-transparent opacity-90`} />\n                \n                <div className=\"absolute bottom-0 left-0 right-0 p-8 flex justify-between items-end\">\n                  <div className=\"text-white\">\n                    <span className=\"text-[11px] font-medium tracking-widest text-white/70 block mb-1\">{proj.category}</span>\n                    <h3 className=\"font-serif text-2xl font-medium\">{proj.title}</h3>\n                  </div>\n                  <button className=\"w-8 h-8 rounded-full border border-white/30 flex items-center justify-center text-white backdrop-blur-sm hover:bg-white hover:text-black transition-colors\">\n                    <ArrowRight size={14} />\n                  </button>\n                </div>\n              </motion.div>\n            ))}\n          </div>\n          \n          <div className=\"flex justify-end gap-4 mt-4 hidden lg:flex\">\n             <button className=\"w-12 h-12 rounded-full border border-wo-border text-wo-text-muted flex items-center justify-center hover:border-wo-text hover:text-wo-text transition-colors\">\n               <ArrowLeft size={1