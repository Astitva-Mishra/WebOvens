    replacement_infos {
      original_chunk {
        target_content: "\'use client\';\n\nimport { motion } from \'motion/react\';\nimport Image from \'next/image\';\n\nexport default function Portfolio() {\n  const projects = [\n    {\n      title: \'Aura Fintech\',\n      category: \'Web Platform\',\n      image: \'https://picsum.photos/seed/fintech/1200/800\',\n    },\n    {\n      title: \'Lumina Luxury\',\n      category: \'E-Commerce\',\n      image: \'https://picsum.photos/seed/luxury/1200/800\',\n    },\n    {\n      title: \'Nexus Data\',\n      category: \'Dashboard\',\n      image: \'https://picsum.photos/seed/data/1200/800\',\n    },\n  ];\n\n  return (\n    <section id=\"portfolio\" className=\"bg-wo-bg border-b border-wo-border pb-32\">\n      <div className=\"max-w-[1600px] mx-auto\">\n        <div className=\"flex flex-col lg:flex-row justify-between items-end gap-12 p-12 xl:p-16 border-b border-wo-border\">\n          <div className=\"max-w-2xl\">\n            <span className=\"text-[9px] font-bold tracking-[0.25em] uppercase text-wo-text opacity-40 mb-8 block\">02 / FEATURED WORK</span>\n            <h2 className=\"font-serif text-5xl md:text-7xl tracking-tighter text-wo-text mb-6\">\n              Digital products,<br />crafted with purpose<br />and precision.\n            </h2>\n          </div>\n          <button className=\"group flex items-center gap-4 py-3 border-b border-wo-border text-wo-text text-[10px] uppercase tracking-[0.2em] font-bold hover:border-wo-text transition-colors\">\n            Explore All Projects\n            <div className=\"w-1.5 h-1.5 bg-wo-orange transition-transform duration-300 group-hover:scale-150\" />\n          </button>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-0\">\n          {projects.map((proj, i) => (\n            <motion.div \n              key={i}\n              initial={{ opacity: 0 }}\n              whileInView={{ opacity: 1 }}\n              viewport={{ once: true }}\n              transition={{ delay: i * 0.1 }}\n              className={`group flex flex-col border-b lg:border-b-0 border-wo-border ${i !== projects.length - 1 ? \'lg:border-r\' : \'\'}`}\n            >\n              <div className=\"relative aspect-[4/5] overflow-hidden bg-[#EAEAEA]\">\n                <Image \n                  src={proj.image}\n                  alt={proj.title}\n                  fill\n                  referrerPolicy=\"no-referrer\"\n                  className=\"object-cover opacity-80 mix-blend-multiply transition-transform duration-1000 group-hover:scale-[1.03] grayscale group-hover:grayscale-0\"\n                />\n              </div>\n              <div className=\"p-8 lg:p-12 flex flex-col justify-between flex-grow bg-wo-bg\">\n                <span className=\"text-[10px] uppercase tracking-[0.2em] font-bold opacity-40 mb-4\">{proj.category}</span>\n                <div className=\"flex justify-between items-center mt-auto\">\n                  <h3 className=\"font-serif text-3xl font-light text-wo-text group-hover:italic transition-all\">{proj.title}</h3>\n                  <div className=\"w-8 h-8 rounded-full border border-wo-border flex items-center justify-center opacity-0 -translate-x-4 group-hover:opacity-100 group-hover:translate-x-0 transition-all text-wo-text\">\n                    <span className=\"text-[10px]\">\342\206\222</span>\n                  </div>\n                </div>\n              </div>\n            </motion.div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n}"
        replacement_content: "\'use client\';\n\nimport { motion } from \'motion/react\';\nimport Image from \'next/image\';\nimport { ArrowRight, ArrowLeft } from \'lucide-react\';\n\nexport default function Portfolio() {\n  const projects = [\n    { title: \'Nexora\', category: \'SaaS Platform\', image: \'https://picsum.photos/seed/nexora12/1000/1000\', dark: true },\n    { title: \'Lumen Pay\', category: \'Fintech\', image: \'https://picsum.photos/seed/lumen45/1000/1000\', dark: false },\n    { title: \'FortuneFlow\', category: \'AI Startup\', image: \'https://picsum.photos/seed/fort7/1000/1000\', dark: true },\n  ];\n\n  return (\n    <section id=\"portfolio\" className=\"bg-wo-bg border-b border-wo-border p-6 md:p-12 xl:p-16\">\n      <div className=\"max-w-[1500px] mx-auto grid grid-cols-1 xl:grid-cols-4 gap-8\">\n        \n        {/* Left Titling Column */}\n        <div className=\"xl:col-span-1 flex flex-col pt-8\">\n          <div className=\"flex items-center gap-4 mb-8\">\n            <span className=\"text-[10px] font-bold tracking-[0.2em] uppercase text-wo-orange\">FEATURED WORK</span>\n            <div className=\"h-[1px] w-8 bg-wo-orange/50\" />\n          </div>\n          \n          <h2 className=\"font-serif text-4xl md:text-5xl lg:text-[52px] leading-[1.05] tracking-tight text-wo-text mb-12\">\n            Digital products,<br />crafted with purpose<br />and precision.\n          </h2>\n\n          <button className=\"group flex items-center gap-3 text-wo-text text-[13px] font-bold border-b border-wo-text pb-1 hover:text-wo-orange hover:border-wo-orange transition-colors w-max\">\n            Explore All Projects\n            <div className=\"w-1.5 h-1.5 bg-wo-orange rounded-full group-hover:scale-150 transition-transform\" />\n          </button>\n        </div>\n\n        {/* 3 Project Cards */}\n        <div className=\"xl:col-span-3 grid grid-cols-1 md:grid-cols-3 gap-6 relative\">\n          {projects.map((proj, i) => (\n            <motion.div \n              key={i}\n              initial={{ opacity: 0 }}\n              whileInView={{ opacity: 1 }}\n              viewport={{ once: true }}\n              transition={{ delay: i * 0.1 }}\n              className={`flex flex-col group ${proj.dark ? \'bg-[#0A0A0A] text-white\' : \'bg-[#EAEAEA] text-[#111111]\'}`}\n            >\n              <div className=\"relative aspect-[1/1] overflow-hidden mb-0\">\n                <Image \n                  src={proj.image} \n                  alt={proj.title} \n                  fill \n                  className=\"object-cover transition-transform duration-700 group-hover:scale-[1.03]\" \n                  referrerPolicy=\"no-referrer\"\n                />\n              </div>\n              <div className=\"p-6 flex flex-col justify-between relative z-10 -mt-1\">\n                <span className={`text-[10px] font-medium tracking-wide mb-2 opacity-60`}>{proj.category}</span>\n                <div className=\"flex justify-between items-center mt-2\">\n                  <h3 className=\"font-serif text-2xl\">{proj.title}</h3>\n                  <div className={`w-8 h-8 rounded-full border flex items-center justify-center transition-colors ${proj.dark ? \'border-white/20 group-hover:border-white\' : \'border-black/20 group-hover:border-black\'}`}>\n                    <ArrowRight size={14} strokeWidth={1.5} />\n                  </div>\n                </div>\n              </div>\n            </motion.div>\n          ))}\n          \n          {/* External Arrows to the side (simulated) */}\n          <div className=\"hidden 2xl:flex absolute -right-24 top-1/2 -translate-y-1/2 flex-col gap-4\">\n             <button className=\"w-12 h-12 rounded-full border border-wo-border bg-wo-bg flex items-center justify-center hover:border-wo-orange hover:text-wo-orange transition-colors opacity-50\">\n               <ArrowLeft size={16} strokeWidth={1} />\n             </button>\n             <button className=\"w-12 h-12 rounded-full border border-wo-border bg-wo-bg flex items-center justify-center hover:border-wo-orange hover:text-wo-orange transition-colors\">\n               <ArrowRight size={16} strokeWidth={1} />\n             </button>\n          </div>\n        </div>\n        \n      </div>\n    </section>\n  );\n}"
      }
      num_matches: 1
    }
  }
